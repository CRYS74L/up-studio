{
  "name": "bilibili-data-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:ui": "playwright test",
    "cf:typegen": "wrangler types",
    "deploy": "npm run build && wrangler deploy",
    "local:start": "powershell -NoProfile -ExecutionPolicy Bypass -File runtime/manage.ps1 -Action Start",
    "local:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File runtime/manage.ps1 -Action Stop",
    "local:update": "powershell -NoProfile -ExecutionPolicy Bypass -File runtime/update.ps1",
    "test:runtime": "node runtime/d1.test.mjs"
  },
  "dependencies": {
    "@hono/zod-validator": "0.9.0",
    "@tanstack/react-query": "5.101.4",
    "echarts": "6.1.0",
    "hono": "4.13.1",
    "lucide-react": "1.31.0",
    "motion": "13.2.0",
    "qrcode": "1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.51.3",
    "@cloudflare/workers-types": "5.20260812.1",
    "@playwright/test": "1.62.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.2.0",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "jsdom": "30.0.1",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.10",
    "wrangler": "4.121.0"
  }
}
